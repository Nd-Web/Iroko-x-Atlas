# ==============================================================================
# IROKO AI — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and fill in your values.
# Variables marked [REQUIRED] will cause the app to refuse to start if blank.
# Variables marked [OPTIONAL] enable additional features; the app runs without them.
#
# Bright Data free trial: https://brightdata.com (no credit card required for hackathon)
# Azure free tier:        https://azure.microsoft.com/en-us/free
# ==============================================================================


# ------------------------------------------------------------------------------
# SECURITY                                                         [REQUIRED]
# ------------------------------------------------------------------------------

# JWT signing key. Must be at least 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_64_char_hex_secret_key_here


# ------------------------------------------------------------------------------
# DATABASE                                                         [REQUIRED]
# ------------------------------------------------------------------------------

# PostgreSQL connection string. When running via docker-compose, this is set
# automatically from POSTGRES_* vars below — you don't need to edit it.
# For local dev without Docker, point to your local Postgres instance.
DATABASE_URL=postgresql://iroko:iroko_secret@localhost:5432/iroko_db

# Docker Compose Postgres credentials (used to build DATABASE_URL inside Compose)
POSTGRES_USER=iroko
POSTGRES_PASSWORD=iroko_secret
POSTGRES_DB=iroko_db


# ------------------------------------------------------------------------------
# BRIGHT DATA — Web Intelligence Layer                             [REQUIRED for live signals]
# ------------------------------------------------------------------------------
# Get from: https://brightdata.com → Dashboard → Account Settings → API Keys
# Without these, the system runs in mock mode (simulated signals, no live web data).

# Your Bright Data account API key.
# Get from: https://brightdata.com → Account Settings → API Keys
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Your Bright Data numeric customer/account ID (shown next to your username).
# Get from: https://brightdata.com → Account Settings → Customer ID
BRIGHTDATA_CUSTOMER_ID=your_customer_id_here

# Web Unlocker proxy endpoint — used for ncc.gov.ng and JS-rendered African web sources.
# Get from: https://brightdata.com → Zone settings → Web Unlocker → Host:Port
BRIGHTDATA_WEB_UNLOCKER_ENDPOINT=https://brd.superproxy.io:22225

# SERP API endpoint — used for real-time competitor and market signal sweeps.
# Get from: https://brightdata.com → Zone settings → SERP API → Endpoint
BRIGHTDATA_SERP_API_ENDPOINT=https://api.brightdata.com/serp

# Proxy zone name — must match the zone configured in your Bright Data dashboard.
# Get from: https://brightdata.com → Zone settings → Zone name
BRIGHTDATA_ZONE=residential


# ------------------------------------------------------------------------------
# BRIGHT DATA — Optional / Advanced                                [OPTIONAL]
# ------------------------------------------------------------------------------

# MCP (Model Context Protocol) server URL — enables LLM-native mid-reasoning
# web access directly from Semantic Kernel agent tool calls.
# Get from: https://brightdata.com → MCP Server → Enable → Copy URL
BRIGHTDATA_MCP_SERVER_URL=

# Web Scraper API (Datasets v3) — used for schema-driven structured extraction
# from procurement portals and regulatory gazette PDFs.
# Get from: https://brightdata.com → Web Scraper → Dataset ID
BRIGHTDATA_SCRAPER_DATASET_ID=


# ------------------------------------------------------------------------------
# WEB INTELLIGENCE PIPELINE TUNING                                [OPTIONAL]
# ------------------------------------------------------------------------------
# These control runtime behaviour of the web intelligence pipeline.
# Safe to leave at defaults for hackathon evaluation.

# How often the background signal poller refreshes live data (seconds).
# Default: 300 (5 minutes). Lower for demos, raise for production.
WEB_INTEL_REFRESH_INTERVAL_SECONDS=300

# Maximum number of audit trail entries to retain in the database.
# Oldest entries are pruned when this limit is reached. Default: 10000
AUDIT_TRAIL_MAX_ENTRIES=10000

# Enable live NCC rule compilation from ncc.gov.ng on each regulatory scan.
# Set to false to use the cached corpus only (useful when offline or rate-limited).
# Default: true
NCC_LIVE_RULES_ENABLED=true

# Minimum compound risk score (0.0–1.0) for the signal graph to surface an entity
# as a high-risk compound threat. Entities below this threshold are filtered out.
# Default: 0.6
SIGNAL_GRAPH_RISK_THRESHOLD=0.6


# ------------------------------------------------------------------------------
# AZURE OPENAI                                                     [REQUIRED for LLM features]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Azure OpenAI → Keys and Endpoint

AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Deployment names — must match what you created in Azure OpenAI Studio
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_NANO_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large


# ------------------------------------------------------------------------------
# AZURE OPENAI RESPONSES API — main chat/text LLM (StrategistAgent) [OPTIONAL]
# ------------------------------------------------------------------------------
# Azure AI Foundry's unified v1 endpoint (no api-version query param). When
# set, this replaces the Chat Completions resource above as the LLM behind
# every agent (agents/kernel.py: llm_complete / llm_complete_stream). The
# Foundry resource only needs ONE text deployment — every service_id tier
# (flagship/gpt4o/nano) resolves to it, so there's no separate fast/cheap
# tier once this is active.

AZURE_OPENAI_RESPONSES_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_RESPONSES_API_KEY=your_azure_ai_foundry_api_key_here
AZURE_OPENAI_RESPONSES_DEPLOYMENT=gpt-5.6-sol


# ------------------------------------------------------------------------------
# AZURE OPENAI REALTIME — Voice (TTS, STT, WebRTC widget)          [OPTIONAL]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com (or Microsoft Foundry) → your Realtime
# deployment → Endpoint and Keys. Must be a resource with a `gpt-realtime*`
# model deployed (East US 2 or Sweden Central for global deployments).
# Without these, meeting voice, "speak to check", and the voice widget are disabled.

AZURE_OPENAI_REALTIME_ENDPOINT=https://your-realtime-resource.openai.azure.com
AZURE_OPENAI_REALTIME_API_KEY=your_azure_openai_realtime_api_key_here
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1

# Preset voice for spoken output: alloy, ash, ballad, coral, echo, sage,
# shimmer, verse, or marin. No custom/Nigerian-accented voice is available.
AZURE_OPENAI_REALTIME_VOICE=marin


# ------------------------------------------------------------------------------
# AZURE SERVICE PRINCIPAL                                          [REQUIRED for Azure]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Azure Active Directory → App registrations

AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/


# ------------------------------------------------------------------------------
# AZURE AI SEARCH                                                  [REQUIRED for RAG]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Azure AI Search → Keys

AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_admin_key_here
AZURE_SEARCH_INDEX_NAME=iroko-chunks
AZURE_SEARCH_SEMANTIC_CONFIG=iroko-semantic


# ------------------------------------------------------------------------------
# AZURE DOCUMENT INTELLIGENCE                                      [REQUIRED for doc ingestion]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Document Intelligence → Keys and Endpoint

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here


# ------------------------------------------------------------------------------
# AZURE BLOB STORAGE                                               [REQUIRED for doc storage]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Storage Account → Access keys → Connection string

AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=raw-documents


# ------------------------------------------------------------------------------
# AZURE COSMOS DB (Gremlin)                                        [REQUIRED for knowledge graph]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Cosmos DB → Connection strings

COSMOS_GREMLIN_ENDPOINT=wss://your-cosmos-account.gremlin.cosmos.azure.com:443/
COSMOS_PRIMARY_KEY=your_cosmos_primary_key_here
COSMOS_DATABASE=iroko-graph-db
COSMOS_GRAPH=iroko-knowledge-graph


# ------------------------------------------------------------------------------
# AZURE COMMUNICATION SERVICES                                     [REQUIRED for email alerts]
# ------------------------------------------------------------------------------
# Get from: https://portal.azure.com → Communication Services → Keys

ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=your_key_here


# ------------------------------------------------------------------------------
# OPTIONAL CONNECTORS                                              [OPTIONAL]
# ------------------------------------------------------------------------------
# These unlock specific integrations. The app runs without them.

# Cohere reranking (improves document search quality in the RAG pipeline)
# Get from: https://dashboard.cohere.com → API Keys
COHERE_API_KEY=

# Azure Speech Services (voice query support)
AZURE_SPEECH_KEY=

# Slack integration
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ServiceNow integration
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# FRONTEND                                                         [OPTIONAL]
# ------------------------------------------------------------------------------

# Public API URL used by the Next.js frontend.
# In Docker Compose this is set automatically; only override for custom deployments.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend URL — used in email alert links
FRONTEND_URL=http://localhost:3000

# OAuth redirect URI for Microsoft Graph connectors
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:3000/connectors/callback
