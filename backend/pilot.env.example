# Iroko AI pilot booking and Zoho SMTP
# Copy these names into the backend host's secret/environment settings.
# Never commit the real app password.

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USERNAME=ekeh@irokoai.site
ZOHO_SMTP_PASSWORD=replace-with-zoho-app-password
# Prefer Brevo HTTPS in production; it avoids Render SMTP port restrictions.
BREVO_API_KEY=replace-with-brevo-api-key
PILOT_FROM_EMAIL=ekeh@irokoai.site
PILOT_NOTIFICATION_EMAIL=ndubuisiekeh169@gmail.com

# Availability is interpreted in West Africa Time (UTC+1).
PILOT_BUSINESS_START_HOUR_WAT=9
PILOT_BUSINESS_END_HOUR_WAT=17

# Google Calendar OAuth (calendar owner account, offline access).
# When REQUIRED=true, bookings fail safely instead of falling back to DB-only slots.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_CALENDAR_REQUIRED=true
