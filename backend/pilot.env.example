# Iroko AI pilot booking and Zoho SMTP
# Copy these names into the backend host's secret/environment settings.
# Never commit the real app password.

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USERNAME=ekeh@irokoai.site
ZOHO_SMTP_PASSWORD=replace-with-zoho-app-password
PILOT_FROM_EMAIL=ekeh@irokoai.site
PILOT_NOTIFICATION_EMAIL=ndubuisiekeh169@gmail.com

# Availability is interpreted in West Africa Time (UTC+1).
PILOT_BUSINESS_START_HOUR_WAT=9
PILOT_BUSINESS_END_HOUR_WAT=17
